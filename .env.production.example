# House Shop — Production Environment Variables (Railway, bitta service)
# Bu qiymatlarni Railway -> Variables bo'limiga kiriting.
# Eslatma: NEXT_PUBLIC_* o'zgaruvchilari build vaqtida kodga singdiriladi,
# shuning uchun ular Dockerfile ichida berilgan (NEXT_PUBLIC_API_URL=/api/v1).

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Railway avtomatik beradi (qo'lda kiritish shart emas):
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# CORS / CSRF — Railway domeni RAILWAY_PUBLIC_DOMAIN orqali avtomatik qo'shiladi
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Ma'lumotlar bazasi — doimiy saqlash uchun PostgreSQL tavsiya etiladi
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Superuser (ensure_superuser buyrug'i uchun)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Frontend -> Django proxy manzili (Next.js rewrites ishlatadi)
BACKEND_URL=http://127.0.0.1:8000
